# ---------------------------------------------------------------------------
# WAAM thin-wall milling monitoring - files kept OUT of version control.
# Everything excluded here is listed in README.md, "Data (available on request)".
# ---------------------------------------------------------------------------

# Python / environment / caches
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
outputs_quick_check/

# Derived feature caches (regenerated by: python run_pipeline.py prepare)
data/processed/*.npz
_archive/processed_features_literature_pilot/*.npz

# Thermal camera records (out of scope for this project; see AUDIT.md section H)
*.irgd

# Kistler DynoWare binary force records (all ~53.5 MB; CSV exports are used instead)
*.dwd

# External public datasets (download from their DOIs; see external/DATASETS.md)
external/turning_chatter_mendeley/
external/kit_cnc_milling/
# Unlicensed, unattributed files - never redistribute (AUDIT.md item 17)
external/_quarantine/

# OPTIONAL: uncomment to keep the WHOLE raw archive out of git.
# With only the rules in this file, ~1.5 GB of raw data in WAAM/ (vibration CSVs,
# .rdf/.dac, .mp4 videos, ANSYS files) would still be tracked.
# /WAAM/

